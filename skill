#!/usr/bin/env bash
set -euo pipefail

CENTRAL_STORE="${XDG_DATA_HOME:-$HOME/.local/share}/skills"
TOOL_PATHS=(
    "$HOME/.codex/skills"
    "$HOME/.claude/skills"
    "$HOME/.config/opencode/skills"
    "$HOME/.agents/skills"
    "$HOME/.config/agents/skills"
    "$HOME/.local/share/hermes/skills"
)
ASSUME_YES=0

_green()  { printf '\033[32m%s\033[0m\n' "$*"; }
_yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
_red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }

# Print prompt $1, read a yes/no answer, honor ASSUME_YES for non-interactive use.
# $2 = "yes" requires the exact word; "y" accepts y/Y. Returns 0 on yes, 1 on no.
_confirm() {
    local prompt="$1" mode="$2" answer
    if [[ "$ASSUME_YES" == 1 ]]; then
        answer="$mode"
    else
        printf '%s' "$prompt"
        read -r answer
    fi
    if [[ "$mode" == "yes" ]]; then
        [[ "$answer" == "yes" ]]
    else
        [[ "$answer" =~ ^[Yy]$ ]]
    fi
}

usage() {
    cat <<EOF
skill — install AI coding skills from any directory

Usage:
  skill install      <path|git-url>   Install a skill by local path or git URL
  skill install-all  [repo-path]      Install all skills from a repo (default: ./skills/)
  skill remove       <name>           Remove an installed skill
  skill remove-all                    Remove all installed skills
  skill reinstall-all [repo-path]     Remove all then reinstall from repo
  skill repair                        Repair managed links and prune broken managed links
  skill list                          List all installed skills
  skill update       <name>           Pull latest (git-cloned skills) or no-op (symlinked)

Options:
  -y, --yes          Answer all confirmations non-interactively (for scripts/CI)

Examples:
  skill install ./my-skill
  skill install https://github.com/user/my-skill
  skill install git@github.com:user/my-skill.git
  skill install-all
  skill install-all /path/to/repo
  skill reinstall-all /path/to/repo
  skill -y reinstall-all           non-interactive reinstall (scripts/CI)
  skill remove  my-skill
  skill remove-all
  skill list
  skill update  my-skill
EOF
}

_is_git_url() {
    [[ "$1" =~ ^https?:// ]] || [[ "$1" =~ ^git@ ]]
}

_skill_name_from_url() {
    local url="$1"
    basename "$url" .git
}

_link_to_tools() {
    local name="$1"
    local force="${2:-false}"
    local central="$CENTRAL_STORE/$name"
    local linked=()
    for tool_dir in "${TOOL_PATHS[@]}"; do
        local link="$tool_dir/$name"
        mkdir -p "$tool_dir"
        if [[ -L "$link" ]]; then
            local existing
            existing=$(readlink "$link")
            if [[ "$existing" == "$central" ]]; then
                continue   # already correct
            fi
            rm "$link"
        elif [[ -d "$link" ]]; then
            if [[ "$force" == true ]]; then
                rm -rf "$link"
            else
                _yellow "WARNING: $link is a real directory (not managed by skill). Skipping to avoid data loss."
                _yellow "  Run 'skill repair' to replace stale real directories with symlinks."
                continue
            fi
        elif [[ -e "$link" ]]; then
            rm "$link"
        fi
        ln -s "$central" "$link"
        linked+=("$tool_dir")
    done
    printf '%s\n' "${linked[@]:-}"
}

_unlink_from_tools() {
    local name="$1"
    local central="$CENTRAL_STORE/$name"
    for tool_dir in "${TOOL_PATHS[@]}"; do
        local link="$tool_dir/$name"
        if [[ -L "$link" ]]; then
            local target
            target=$(readlink "$link" 2>/dev/null || true)
            if [[ "$target" == "$central" || -z "$target" ]]; then
                rm "$link"
            fi
        fi
    done
}

# Link the shared common/ directory (skills/common) into the central store and
# every tool path so installed skills can resolve their ../common/... references.
# Idempotent. No-op if the source directory does not exist.
_link_shared_common() {
    local common_src="$1"
    [[ -d "$common_src" ]] || return 0

    mkdir -p "$CENTRAL_STORE"
    local central="$CENTRAL_STORE/common"

    if [[ -L "$central" ]]; then
        rm "$central"
    elif [[ -d "$central" ]]; then
        rm -rf "$central"
    elif [[ -e "$central" ]]; then
        rm "$central"
    fi
    ln -s "$common_src" "$central"
    _link_to_tools "common" true > /dev/null
    _green "  ✓ common (shared)"
}

cmd_install() {
    local source="${1:-}"
    if [[ -z "$source" ]]; then
        _red "Usage: skill install <path|git-url>"
        exit 1
    fi

    local name
    local is_git=false

    if _is_git_url "$source"; then
        is_git=true
        name=$(_skill_name_from_url "$source")
    else
        if [[ ! -e "$source" ]]; then
            _red "Path not found: $source"
            exit 1
        fi
        source=$(realpath "$source")
        name=$(basename "$source")
        if [[ ! -f "$source/SKILL.md" ]]; then
            _yellow "Warning: no SKILL.md found in $source — installing anyway"
        fi
    fi

    mkdir -p "$CENTRAL_STORE"
    local central="$CENTRAL_STORE/$name"

    # Handle already-installed
    if [[ -e "$central" || -L "$central" ]]; then
        local is_real_dir=false
        [[ -d "$central" && ! -L "$central" ]] && is_real_dir=true

        if [[ "$is_real_dir" == true ]]; then
            _red "WARNING: \"$name\" is a git-cloned skill with real files at $central"
            _red "Overwriting will PERMANENTLY DELETE all those files."
            _confirm 'Type "yes" to permanently delete and overwrite: ' yes || { echo "Aborted."; exit 0; }
        else
            _confirm "Skill \"$name\" is already installed. Overwrite? [y/N] " y || { echo "Aborted."; exit 0; }
        fi

        _unlink_from_tools "$name"
        if [[ -L "$central" ]]; then
            rm "$central"
        elif [[ -d "$central" ]]; then
            rm -rf "$central"
        fi
    fi

    if [[ "$is_git" == true ]]; then
        echo "Cloning $source ..."
        git clone "$source" "$central"
    else
        ln -s "$source" "$central"
    fi

    _link_to_tools "$name" > /dev/null
    # Provision shared common/ if it sits beside the installed skill's source.
    if [[ "$is_git" != true ]]; then
        _link_shared_common "$(dirname "$source")/common"
    fi
    _green "✓ Installed $name"
    echo "  central : $central"
    for tool_dir in "${TOOL_PATHS[@]}"; do
        [[ -L "$tool_dir/$name" ]] && echo "  $(basename "$tool_dir") : $tool_dir/$name"
    done
}

cmd_remove() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        _red "Usage: skill remove <name>"
        exit 1
    fi

    local central="$CENTRAL_STORE/$name"
    if [[ ! -e "$central" && ! -L "$central" ]]; then
        _red "Skill not found: $name"
        exit 1
    fi

    _unlink_from_tools "$name"

    if [[ -L "$central" ]]; then
        rm "$central"
        _green "✓ Removed $name"
    elif [[ -d "$central" ]]; then
        _yellow "\"$name\" unlinked from all tools."
        _yellow "Original files at $central were NOT deleted."
        _yellow "To fully purge: rm -rf \"$central\""
    fi
}

cmd_list() {
    if [[ ! -d "$CENTRAL_STORE" ]]; then
        echo "(no skills installed)"
        return
    fi

    local found=false
    while IFS= read -r -d '' entry; do
        found=true
        local name
        name=$(basename "$entry")
        if [[ -L "$entry" ]]; then
            local target state="symlink"
            target=$(readlink "$entry")
            [[ -e "$entry" ]] || state="BROKEN symlink"
            printf '%-30s [%s → %s]\n' "$name" "$state" "$target"
        else
            local branch=""
            branch=$(git -C "$entry" branch --show-current 2>/dev/null || true)
            local tag="${branch:+$branch}"
            printf '%-30s [git clone%s]\n' "$name" "${tag:+ @ $tag}"
        fi
    done < <(find "$CENTRAL_STORE" -maxdepth 1 -mindepth 1 \( -type d -o -type l \) -print0 | sort -z)

    [[ "$found" == false ]] && echo "(no skills installed)"
}

cmd_update() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        _red "Usage: skill update <name>"
        exit 1
    fi

    local central="$CENTRAL_STORE/$name"
    if [[ ! -e "$central" && ! -L "$central" ]]; then
        _red "Skill not found: $name"
        exit 1
    fi

    if [[ -L "$central" ]]; then
        _yellow "\"$name\" is a symlink to a local path — it updates automatically."
        echo "  → $(readlink "$central")"
    else
        echo "Pulling latest for $name ..."
        git -C "$central" pull
        _green "✓ Updated $name"
    fi
}

cmd_install_all() {
    local repo_path="${1:-./skills}"

    if [[ ! -d "$repo_path" ]]; then
        _red "Skills directory not found: $repo_path"
        exit 1
    fi

    local -a skills=()
    while IFS= read -r -d '' dir; do
        skills+=("$dir")
    done < <(find "$repo_path" -maxdepth 1 -mindepth 1 -type d -print0 | sort -z)

    if [[ ${#skills[@]} -eq 0 ]]; then
        _red "No skill directories found in $repo_path"
        exit 1
    fi

    echo "Found ${#skills[@]} skills in $repo_path"
    echo ""
    _confirm 'Install all of them? [y/N] ' y || { echo "Aborted."; exit 0; }

    mkdir -p "$CENTRAL_STORE"

    local count=0 failed=0
    for dir in "${skills[@]}"; do
        local name
        name=$(basename "$dir")
        if [[ ! -f "$dir/SKILL.md" ]]; then
            _yellow "Skipping $name — no SKILL.md found"
            (( ++failed )) || true
            continue
        fi
        _install_one "$dir" "$name"
        (( ++count )) || true
    done

    # Provision the shared common/ directory so ../common/... references resolve.
    _link_shared_common "$(realpath "$repo_path/common" 2>/dev/null || true)"

    echo ""
    _green "Installed $count skills."
    [[ $failed -gt 0 ]] && _yellow "Skipped $failed directories (no SKILL.md)."
}

cmd_remove_all() {
    if [[ ! -d "$CENTRAL_STORE" ]]; then
        echo "No skills installed."
        return
    fi

    local -a installed=()
    while IFS= read -r -d '' entry; do
        installed+=("$(basename "$entry")")
    done < <(find "$CENTRAL_STORE" -maxdepth 1 -mindepth 1 \( -type d -o -type l \) -print0 | sort -z)

    if [[ ${#installed[@]} -eq 0 ]]; then
        echo "No skills installed."
        return
    fi

    echo "This will permanently remove ${#installed[@]} installed skills."
    _confirm 'Type "yes" to confirm: ' yes || { echo "Aborted."; exit 0; }

    local count=0
    for name in "${installed[@]}"; do
        _unlink_from_tools "$name"
        local central="$CENTRAL_STORE/$name"
        if [[ -L "$central" ]]; then
            rm "$central"
        elif [[ -d "$central" ]]; then
            rm -rf "$central"
        fi
        (( ++count )) || true
    done

    _green "Removed $count skills."
}

cmd_reinstall_all() {
    if [[ -d "$CENTRAL_STORE" ]]; then
        cmd_remove_all
    fi
    echo ""
    cmd_install_all "$@"
}

cmd_repair() {
    if [[ ! -d "$CENTRAL_STORE" ]]; then
        echo "No skills installed in central store."
        return
    fi

    local count=0

    # Drop central entries that are symlinks to a source that no longer exists
    # (a skill directory deleted from its repo). Tool links to them are pruned
    # below once the entry is gone.
    while IFS= read -r -d '' entry; do
        if [[ -L "$entry" && ! -e "$entry" ]]; then
            _yellow "Pruning dead central link: $entry → $(readlink "$entry")"
            rm "$entry"
            (( ++count )) || true
        fi
    done < <(find "$CENTRAL_STORE" -maxdepth 1 -mindepth 1 -type l -print0)

    # Remove orphaned tool links only when they point into this central store
    # and their central entry no longer exists. Leave unrelated user-managed
    # links untouched.
    for tool_dir in "${TOOL_PATHS[@]}"; do
        [[ -d "$tool_dir" ]] || continue
        while IFS= read -r -d '' link; do
            local target
            target=$(readlink "$link" 2>/dev/null || true)
            if [[ "$target" == "$CENTRAL_STORE/"* && ! -e "$target" && ! -L "$target" ]]; then
                _yellow "Pruning broken managed link: $link"
                rm "$link"
                (( ++count )) || true
            fi
        done < <(find "$tool_dir" -maxdepth 1 -mindepth 1 -type l -print0)
    done

    while IFS= read -r -d '' entry; do
        local name
        name=$(basename "$entry")
        for tool_dir in "${TOOL_PATHS[@]}"; do
            local link="$tool_dir/$name"
            if [[ -d "$link" && ! -L "$link" ]]; then
                _yellow "Replacing stale real dir: $link"
                rm -rf "$link"
                ln -s "$CENTRAL_STORE/$name" "$link"
                _green "  ✓ $name → $tool_dir"
                (( ++count )) || true
            elif [[ -L "$link" ]]; then
                local target
                target=$(readlink "$link" 2>/dev/null || true)
                if [[ "$target" != "$CENTRAL_STORE/$name" ]]; then
                    _yellow "Replacing stale link: $link"
                    rm "$link"
                    ln -s "$CENTRAL_STORE/$name" "$link"
                    _green "  ✓ $name → $tool_dir"
                    (( ++count )) || true
                fi
            elif [[ ! -e "$link" ]]; then
                mkdir -p "$tool_dir"
                ln -s "$CENTRAL_STORE/$name" "$link"
                _green "  ✓ $name → $tool_dir"
                (( ++count )) || true
            fi
        done
    done < <(find "$CENTRAL_STORE" -maxdepth 1 -mindepth 1 \( -type d -o -type l \) -print0 | sort -z)

    # Recreate shared common/ tool-path links if common is provisioned centrally.
    if [[ -e "$CENTRAL_STORE/common" || -L "$CENTRAL_STORE/common" ]]; then
        _link_to_tools "common" true > /dev/null
        (( ++count )) || true
    fi

    if [[ $count -eq 0 ]]; then
        _green "No stale skill directories found — all tool paths look clean."
    else
        _green "Repaired $count stale skill link(s)."
    fi
}

_install_one() {
    local source="$1"
    local name="$2"

    local central="$CENTRAL_STORE/$name"

    if [[ -L "$central" ]] || [[ -e "$central" ]]; then
        _unlink_from_tools "$name"
        [[ -L "$central" ]] && rm "$central"
        [[ -d "$central" ]] && rm -rf "$central"
    fi

    ln -s "$(realpath "$source")" "$central"
    _link_to_tools "$name" true > /dev/null
    _green "  ✓ $name"
}

# ── dispatch ──────────────────────────────────────────────────────────────────

# Strip -y/--yes from any position so it works before or after the subcommand.
ARGS=()
for _a in "$@"; do
    case "$_a" in
        -y|--yes) ASSUME_YES=1 ;;
        *) ARGS+=("$_a") ;;
    esac
done
set -- "${ARGS[@]}"

case "${1:-}" in
    install)   shift; cmd_install "$@" ;;
    install-all) shift; cmd_install_all "$@" ;;
    remove)    shift; cmd_remove  "$@" ;;
    remove-all) cmd_remove_all ;;
    reinstall-all) shift; cmd_reinstall_all "$@" ;;
    repair)    cmd_repair ;;
    list)      cmd_list ;;
    update)    shift; cmd_update  "$@" ;;
    -h|--help|help|"") usage ;;
    *) _red "Unknown command: $1"; echo; usage; exit 1 ;;
esac
