#!/usr/bin/env python3
"""edit - anchored SEARCH/REPLACE file editor.

Usage:
    edit FILE <<'EOF'
    <<<<<<< SEARCH
    exact existing lines
    =======
    replacement lines
    >>>>>>> REPLACE
    EOF

Stack several SEARCH/REPLACE blocks in one call to make several edits.
Blocks apply in order, all-or-nothing: the file is written only if every
SEARCH text matches the (progressively edited) content exactly once.
Exit codes: 0 applied; 1 file error; 2 validation error.
"""
import sys

SEARCH = "<<<<<<< SEARCH"
DIVIDER = "======="
REPLACE = ">>>>>>> REPLACE"


def fail(code, msg):
    print(f"edit: {msg}")
    sys.exit(code)


def parse_blocks(raw):
    blocks = []
    lines = raw.split("\n")
    i = 0
    while i < len(lines):
        line = lines[i].rstrip()
        if line == "":
            i += 1
            continue
        if line != SEARCH:
            fail(2, f"expected {SEARCH!r}, got: {lines[i]!r}")
        i += 1
        search_lines = []
        while i < len(lines) and lines[i].rstrip() != DIVIDER:
            search_lines.append(lines[i])
            i += 1
        if i >= len(lines):
            fail(2, f"missing {DIVIDER!r} divider")
        i += 1
        replace_lines = []
        while i < len(lines) and lines[i].rstrip() != REPLACE:
            replace_lines.append(lines[i])
            i += 1
        if i >= len(lines):
            fail(2, f"missing {REPLACE!r} terminator")
        i += 1
        old = "\n".join(search_lines)
        if old == "":
            fail(2, "SEARCH block is empty")
        blocks.append((old, "\n".join(replace_lines)))
    if not blocks:
        fail(2, "no SEARCH/REPLACE blocks on stdin")
    return blocks


def main():
    if len(sys.argv) != 2:
        fail(2, "usage: edit FILE <<'EOF' ... (SEARCH/REPLACE blocks on stdin)")
    path = sys.argv[1]

    blocks = parse_blocks(sys.stdin.read())

    try:
        with open(path, encoding="utf-8") as f:
            content = f.read()
    except OSError as e:
        fail(1, str(e))
    original = content

    for n, (old, new) in enumerate(blocks, 1):
        count = content.count(old)
        if count == 0:
            first = old.split("\n", 1)[0]
            hint = (
                "its first line does appear, so whitespace or context differs - re-read the file"
                if first and first in content
                else "not even its first line appears - re-read the file"
            )
            fail(2, f"block {n}: SEARCH text not found ({hint}). File NOT modified.")
        if count > 1:
            fail(
                2,
                f"block {n}: SEARCH text matches {count} times; "
                "add surrounding lines to make it unique. File NOT modified.",
            )
        content = content.replace(old, new, 1)

    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
    except OSError as e:
        fail(1, str(e))

    # Confirm what changed so the model does not need a follow-up diff:
    # an unscoped `git diff` in a shared dirty tree dumps unrelated WIP.
    delta = content.count("\n") - original.count("\n")
    total = content.count("\n") + 1
    print(
        f"edit: applied {len(blocks)} replacement(s) to {path} "
        f"({delta:+d} lines, file now {total} lines)"
    )


main()
