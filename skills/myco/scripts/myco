#!/usr/bin/env bash
set -euo pipefail

skill_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
myco_checkout="${MYCO_ROOT:-/home/user/code/myco}"
tsx_loader="${myco_checkout}/myco-agent/node_modules/tsx/dist/loader.mjs"

if [[ ! -f "${tsx_loader}" ]]; then
  echo "myco: missing ${tsx_loader}" >&2
  echo "Set MYCO_ROOT to the Myco checkout or run pnpm install in myco-agent." >&2
  exit 2
fi

exec node --import "${tsx_loader}" "${skill_script_dir}/myco.ts" "$@"
