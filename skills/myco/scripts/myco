#!/usr/bin/env bash
set -euo pipefail

skill_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
myco_checkout="${MYCO_ROOT:-/home/user/code/myco}"
myco_agent_dir="${myco_checkout}/myco-agent"
tsx_package="${myco_agent_dir}/node_modules/tsx"
tsx_loader="${tsx_package}/dist/loader.mjs"

if [[ ! -f "${tsx_loader}" ]]; then
  echo "myco: missing ${tsx_loader}" >&2
  echo "Set MYCO_ROOT to the Myco checkout or install myco-agent dependencies." >&2
  exit 2
fi

myco_data_dir="${MYCO_DATA_DIR:-${MYCO_KANBAN_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/myco}}"
entrypoint="${skill_script_dir}/myco.ts"
if [[ "${1:-}" == "inbox" ]]; then
  shift
  entrypoint="${skill_script_dir}/inbox.ts"
  mkdir -p "${myco_data_dir}"
  touch "${myco_data_dir}/threadripper-inbox.lock"
fi
# A scheduled poll and the CLI must not load competing ratchet/session state.
if [[ -f "${myco_data_dir}/threadripper-inbox.lock" ]]; then
  if ! command -v flock >/dev/null; then
    echo "myco: flock is required while the addressed inbox is configured" >&2
    exit 2
  fi
  exec flock -w 240 "${myco_data_dir}/threadripper-inbox.lock" node --import "${tsx_loader}" "${entrypoint}" "$@"
fi
exec node --import "${tsx_loader}" "${entrypoint}" "$@"
